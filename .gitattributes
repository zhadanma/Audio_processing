# 统一换行符：仓库内一律 LF，避免 Windows(CRLF)/Linux 混用产生无意义 diff
* text=auto eol=lf

*.py     text eol=lf
*.pyi    text eol=lf
*.md     text eol=lf
*.toml   text eol=lf
*.cfg    text eol=lf
*.ini    text eol=lf
*.yaml   text eol=lf
*.yml    text eol=lf
*.json   text eol=lf
*.txt    text eol=lf
*.gitignore    text eol=lf
*.gitattributes text eol=lf

# Windows 脚本需要 CRLF
*.bat    text eol=crlf
*.cmd    text eol=crlf
*.ps1    text eol=crlf

# 二进制资源不做换行符转换
*.png    binary
*.jpg    binary
*.ico    binary
*.icns   binary
*.wav    binary
*.flac   binary
*.mp3    binary
*.exe    binary
*.dll    binary
